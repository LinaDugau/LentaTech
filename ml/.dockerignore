# === ML / данные — слишком много для образа ===

# датасеты, материалы (десятки GB) — оба glob варианта на случай
# проблем с кириллицей в .dockerignore
Данные/
Материалы/
Данн*
Матер*
*.mp4

# Бэкапы и старые датасеты YOLO
ml/output/runs/_backup/
ml/output/runs/pricetag_v1/
ml/output/runs/pricetag_v3/
ml/output/runs/pricetag_v5/
# Любые yolo_dataset_* (синтетика 2.3G, combined 2.4G, gt, extended)
ml/output/yolo_dataset*/
# Промежуточные кадры детекта (357 MB)
ml/output/frames/
# Synth-генератор временные файлы (104 MB)
ml/output/synth/
# Старые tracks-backup (291 MB)
ml/output/tracks_*_backup/
# Backup весов (12 MB)
ml/weights_backup/

# YOLO training artifacts — нужны только best.pt из weights/, остальное (PNG-кривые,
# train_batch*.jpg, confusion_matrix) ~30 МБ на запуск × 3 запуска = 90 МБ мусора.
ml/output/runs/*/*.png
ml/output/runs/*/*.jpg
ml/output/runs/*/results.csv
ml/output/runs/*/args.yaml
ml/output/runs/*/labels.jpg
# из weights/ нужен только best.pt, last.pt можно убрать
ml/output/runs/*/weights/last.pt

# Кадры и intermediate-csv (не нужны в образе — пересоздаются при первом
# запуске; для persistence — volume в docker-compose).
ml/output/tracks/
ml/output/ocr_qr_*.csv
ml/output/final_*.csv
ml/output/pseudo_vis/

# Снапшоты экспериментов — не тащим в образ
ml/output/_*/
ml/output/undistort_preview/

db_hack.csv
ml/data/_gt_inspect/
ml/data/_probe/
ml/data/lenta_catalog_hybrid.parquet

# Сетевые сниффы для scraping (большие и не нужны)
*.har

# Backup-папки самих скриптов от итераций
ml/scripts/_backup_*/

# LLM веса (1.8 GB) — пробрасываются через volume в docker-compose
ml/weights/qwen2.5-3b-q4_k_m.gguf

# другие pretrained, которые мы не используем
yolov8s-worldv2.pt

# отчёты по дням не нужны в образе
ml/DAY*_REPORT.md
